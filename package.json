{
  "name": "cabunets-server",
  "version": "1.0.0",
  "main": "dist/app.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "nodemon --exec \"ts-node --transpile-only\" src/app.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test -r ts-node/register/transpile-only tests/affiliate-safety.test.ts tests/affiliate-lifecycle.integration.test.ts",
    "test:unit": "node --test -r ts-node/register/transpile-only tests/affiliate-safety.test.ts",
    "test:integration": "node --test -r ts-node/register/transpile-only tests/affiliate-lifecycle.integration.test.ts",
    "check:deployment": "ts-node --transpile-only scripts/checkAffiliateDeployment.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.2.2",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.5",
    "socket.io": "^4.8.1",
    "stripe": "^20.0.0",
    "validator": "^13.15.23"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.4.2",
    "@types/nodemailer": "^7.0.0",
    "@types/validator": "^13.15.9",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.33.0"
}
